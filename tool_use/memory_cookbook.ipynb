    "**`memory_demo/sample_code/web_scraper_v1.py`**\n",
    "\n",
    "```python\n",
    "\"\"\"\n",
    "并发网页爬虫，存在竞态条件 bug。\n",
    "多个线程在没有同步的情况下修改共享状态。\n",
    "\"\"\"\n",
    "\n",
    "import time\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from typing import List, Dict\n",
    "\n",
    "import requests\n",
    "\n",
    "\n",
    "class WebScraper:\n",
    "    \"\"\"并发获取多个 URL 的网页爬虫。\"\"\"\n",
    "\n",
    "    def __init__(self, max_workers: int = 10):\n",
    "        self.max_workers = max_workers\n",
    "        self.results = []  # BUG: 多个线程访问的共享可变状态！\n",
    "        self.failed_urls = []  # BUG: 另一个竞态条件！\n",
    "\n",
    "    def fetch_url(self, url: str) -> Dict[str, any]:\n",
    "        \"\"\"获取单个 URL 并返回结果。\"\"\"\n",
    "        try:\n",
    "            response = requests.get(url, timeout=5)\n",
    "            response.raise_for_status()\n",
    "            return {\n",
    "                \"url\": url,\n",
    "                \"status\": response.status_code,\n",
    "                \"content_length\": len(response.content),\n",
    "            }\n",
    "        except requests.exceptions.RequestException as e:\n",
    "            return {\"url\": url, \"error\": str(e)}\n",
    "\n",
    "    def scrape_urls(self, urls: List[str]) -> List[Dict[str, any]]:\n",
    "        \"\"\"\n",
    "        并发爬取多个 URL。\n",
    "\n",
    "        BUG: self.results 从多个线程访问而没有加锁！\n",
    "        这会导致竞态条件，结果可能丢失或损坏。\n",
    "        \"\"\"\n",
    "        with ThreadPoolExecutor(max_workers=self.max_workers) as executor:\n",
    "            futures = [executor.submit(self.fetch_url, url) for url in urls]\n",
    "\n",
    "            for future in as_completed(futures):\n",
    "                result = future.result()\n",
    "\n",
    "                # 竞态条件：多个线程同时追加到 self.results\n",
    "                if \"error\" in result:\n",
    "                    self.failed_urls.append(result[\"url\"])  # 竞态条件\n",
    "                else:\n",
    "                    self.results.append(result)  # 竞态条件\n",
    "\n",
    "        return self.results\n",
    "```"
